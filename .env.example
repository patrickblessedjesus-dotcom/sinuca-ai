# Porta HTTP local
PORT=3000

# Token que VOCÊ inventa e cola também no painel da Meta (Webhook > Verify token)
VERIFY_TOKEN=

# Token de acesso da WhatsApp Cloud API (temporário de 24h ou de usuário do sistema)
WHATSAPP_TOKEN=

# "Phone number ID" mostrado em WhatsApp > API Setup (não é o número de telefone)
PHONE_NUMBER_ID=

# Versão da Graph API (confira a atual no painel da Meta). Padrão do código: v23.0
GRAPH_API_VERSION=

# App Secret (Meta > App settings > Basic). Usado para validar a assinatura do webhook.
APP_SECRET=

# Só para desenvolvimento local! Nunca use true em produção.
SKIP_SIGNATURE_VERIFICATION=false

# Números autorizados (com DDI, só dígitos), separados por vírgula. Vazio = aceita todos.
# Ex.: 5511999998888,5521988887777
ALLOWED_NUMBERS=

OPENAI_API_KEY=

# Modelo multimodal (aceita imagem) habilitado na sua conta. Padrão do código: gpt-4o-mini
OPENAI_MODEL=
